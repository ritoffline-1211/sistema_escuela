{
    "name": "escuela/suite-phpunit",
    "description": "Suite PHPUnit del proyecto escolar (alumnos, grupos, autenticación y documentación)",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Escuela\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
